<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: for Android see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Accent: Telegram blue -->
    <Color x:Key="Accent">#2AABEE</Color>
    <Color x:Key="AccentPressed">#1C8FCB</Color>
    <Color x:Key="OnAccent">#FFFFFF</Color>

    <!-- Dark theme (default design) -->
    <Color x:Key="BackgroundDark">#0E0F12</Color>
    <Color x:Key="SurfaceDark">#1A1C21</Color>
    <Color x:Key="Surface2Dark">#24272D</Color>
    <Color x:Key="BorderDark">#30333A</Color>
    <Color x:Key="TextDark">#F2F1EE</Color>
    <Color x:Key="MutedDark">#8E949C</Color>

    <!-- Light theme -->
    <Color x:Key="BackgroundLight">#F4F5F7</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="Surface2Light">#E9ECF0</Color>
    <Color x:Key="BorderLight">#D9DDE3</Color>
    <Color x:Key="TextLight">#15171B</Color>
    <Color x:Key="MutedLight">#69707A</Color>

    <!-- Status -->
    <Color x:Key="Success">#34C759</Color>
    <Color x:Key="Error">#FF5A52</Color>
    <Color x:Key="Warning">#FFB020</Color>

    <!-- Camera overlay controls (always on top of the dark preview) -->
    <Color x:Key="CameraControl">#73000000</Color>
    <Color x:Key="CameraText">#FFFFFF</Color>
    <Color x:Key="CameraMuted">#B3FFFFFF</Color>

    <!-- Telegram-style preview -->
    <Color x:Key="ChatBackgroundDark">#0F1821</Color>
    <Color x:Key="ChatBackgroundLight">#CFE0EA</Color>
    <Color x:Key="BubbleDark">#182533</Color>
    <Color x:Key="BubbleLight">#FFFFFF</Color>
    <Color x:Key="LinkDark">#6AB2F2</Color>
    <Color x:Key="LinkLight">#168ACD</Color>

    <Color x:Key="Transparent">Transparent</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

</ResourceDictionary>
